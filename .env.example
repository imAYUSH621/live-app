# Staging/demo only. Both flags are IGNORED in production (fail closed):
# they take effect only when NODE_ENV is not 'production'.
# ALLOW_DEMO_LOGIN=true enables the /auth/demo-login guest account route.
# ALLOW_KYC_BYPASS=true makes KYC/host checks report every user as approved.
ALLOW_DEMO_LOGIN=false
ALLOW_KYC_BYPASS=false

# Local test opt-in (NON-PRODUCTION ONLY): production always enforces
# host_only_live=true at both the settings layer and the go-live route, and no
# flag or saved settings row can relax it there. In dev/staging, set
# ALLOW_OPEN_LIVE=true to honor the admin panel setting (including a false
# row) so open go-live can be tested. Without this flag, even non-prod forces
# host_only_live=true.
ALLOW_OPEN_LIVE=false
