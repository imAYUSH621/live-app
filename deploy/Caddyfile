{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

(api) {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /socket.io/* {
		reverse_proxy api:4000
	}
	handle /fx/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy api:4000
	}
	handle /uploads/* {
		header Cache-Control "public, max-age=2592000, immutable"
		reverse_proxy api:4000
	}
}

# User app (PWA) & demo clone endpoints
{$APP_DOMAIN}, demo.omnistu.com, app.omnistu.com {
	encode gzip zstd
	import api

	# Widescreen Desktop Studio experience
	handle_path /stream/* {
		root * /srv/stream
		try_files {path} /index.html
		file_server
	}
	handle /stream {
		redir /stream/ permanent
	}

	# Support demo.omnistu.com/admin directly without separate subdomain
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
	handle /admin {
		redir /admin/ permanent
	}

	# Support demo.omnistu.com/[clone-name] or direct root access
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header / Cache-Control "no-cache, no-store, must-revalidate"
	header /index.html Cache-Control "no-cache, no-store, must-revalidate"
	header /sw.js Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# Admin / agency / coin-seller panel
{$ADMIN_DOMAIN}, admin.omnistu.com {
	encode gzip zstd
	import api

	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	header / Cache-Control "no-cache, no-store, must-revalidate"
	header /index.html Cache-Control "no-cache, no-store, must-revalidate"
	header X-Robots-Tag "noindex"
}

# LiveKit signalling over secure WebSocket
{$LIVE_DOMAIN}, live.omnistu.com {
	reverse_proxy host.docker.internal:7880
}
